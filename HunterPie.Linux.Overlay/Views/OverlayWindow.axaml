<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HunterPie.Linux.Overlay.ViewModels"
        xmlns:views="using:HunterPie.Linux.Overlay.Views"
        x:Class="HunterPie.Linux.Overlay.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Title="HunterPie Overlay"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Panel>
        <!-- Dims the screen in edit mode so the draggable widgets stand out -->
        <Border Background="#55000000" IsVisible="{Binding IsEditing}" IsHitTestVisible="False" />

        <Canvas>
            <Border Name="QuestHost" Classes="host" Classes.editing="{Binding IsEditing}"
                    IsVisible="{Binding ShowQuest}">
                <views:QuestCard DataContext="{Binding Quest}" />
            </Border>

            <Border Name="MonstersHost" Classes="host" Classes.editing="{Binding IsEditing}"
                    IsVisible="{Binding ShowMonsters}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ItemsControl ItemsSource="{Binding Monsters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MonsterViewModel">
                                <views:MonsterCard DataContext="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel IsVisible="{Binding ShowSample}">
                        <views:MonsterCard DataContext="{Binding Sample}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Name="DamageHost" Classes="host" Classes.editing="{Binding IsEditing}"
                    IsVisible="{Binding ShowDamage}">
                <views:DamageCard DataContext="{Binding Damage}" />
            </Border>
        </Canvas>

        <!-- Last, so the buttons stay clickable even when a widget sits underneath -->
        <Border Classes="widget" IsVisible="{Binding IsEditing}" Background="#FF101419"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel Spacing="10">
                <TextBlock Text="Layout edit mode: drag widgets, scroll over one to resize it."
                           Foreground="#FFB84D" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Classes="muted" HorizontalAlignment="Center"
                           Text="Esc saves and leaves edit mode. Widget options live in the HunterPie settings window." />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Name="DoneButton" Content="Save &amp; exit edit mode" Click="OnDoneClick" />
                    <Button Name="QuitButton" Content="Quit HunterPie" Click="OnQuitClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</Window>
