<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HunterPie.Linux.Overlay.ViewModels"
             xmlns:views="using:HunterPie.Linux.Overlay.Views"
             x:Class="HunterPie.Linux.Overlay.Views.DamageCard"
             x:DataType="vm:DamageViewModel">
    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:PlayerDamageViewModel">
            <Grid RowDefinitions="26,Auto">
                <views:ShareBar Grid.RowSpan="2" Percent="{Binding Share}" Slot="{Binding Slot}" IsSelf="{Binding IsSelf}" />
                <DockPanel Grid.Row="0" Margin="6,0,8,0" LastChildFill="True">
                    <Border DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,6,0" CornerRadius="4"
                            VerticalAlignment="Center" Background="#B3101419">
                        <views:WeaponIcon Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Weapon="{Binding Weapon}" />
                    </Border>
                    <TextBlock Classes="number" DockPanel.Dock="Right" Width="38" TextAlignment="Right"
                               VerticalAlignment="Center" Text="{Binding ShareText}" />
                    <TextBlock Classes="number" DockPanel.Dock="Right" Width="64" TextAlignment="Right"
                               VerticalAlignment="Center" Text="{Binding DamageText}" />
                    <TextBlock Classes="muted" DockPanel.Dock="Right" Width="56" TextAlignment="Right"
                               VerticalAlignment="Center" FontFamily="monospace" Text="{Binding DpsText}" />
                    <TextBlock Classes="name" Classes.companion="{Binding IsCompanion}"
                               VerticalAlignment="Center" Text="{Binding Name}" />
                </DockPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="34,-2,8,5"
                            IsVisible="{Binding StatsVisible}">
                    <TextBlock Classes="stat raw" Text="{Binding RawText, StringFormat='ATK {0}'}" />
                    <TextBlock Classes="stat elemental" Text="{Binding ElementalText, StringFormat='ELE {0}'}" />
                    <TextBlock Classes="stat affinity" Text="{Binding AffinityText, StringFormat='AFF {0}'}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Border Classes="widget" Width="340">
        <StackPanel Spacing="6">
            <DockPanel>
                <TextBlock Classes="muted" DockPanel.Dock="Right" VerticalAlignment="Center" Text="{Binding Summary}" />
                <TextBlock Classes="title" Text="Damage" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid Height="150" IsVisible="{Binding ShowGraphPanel}">
                <views:DpsGraph Rows="{Binding Rows}" Count="{Binding GraphCount}" Start="{Binding GraphStart}" Max="{Binding GraphMax}"
                                Version="{Binding GraphVersion}" ShowMarkers="{Binding ShowDpsMarkers}" />
                <TextBlock Classes="muted" FontSize="10" Margin="6,2,0,0" HorizontalAlignment="Left"
                           VerticalAlignment="Top" IsHitTestVisible="False" Text="{Binding GraphMaxText}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding SampleRows}" IsVisible="{Binding ShowSample}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid Height="150" IsVisible="{Binding ShowSampleGraph}">
                <views:DpsGraph Rows="{Binding SampleRows}" Count="{Binding SampleGraphCount}" Max="{Binding SampleGraphMax}" ShowMarkers="True" />
                <TextBlock Classes="muted" FontSize="10" Margin="6,2,0,0" HorizontalAlignment="Left"
                           VerticalAlignment="Top" IsHitTestVisible="False" Text="peak 61 DPS" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
