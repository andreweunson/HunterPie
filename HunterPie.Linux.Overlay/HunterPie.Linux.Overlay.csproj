<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>HunterPie.Linux.Overlay</AssemblyName>
    <RootNamespace>HunterPie.Linux.Overlay</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HunterPie.Linux.Overlay.Tests" />
    <InternalsVisibleTo Include="HunterPie.Linux.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <!-- The headless host owns attaching to the game, the overlay only draws what it reports. Its Address/Game/Languages data flows through. -->
  <ItemGroup>
    <ProjectReference Include="..\HunterPie.Linux\HunterPie.Linux.csproj" />
  </ItemGroup>

</Project>
